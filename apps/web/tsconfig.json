{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@dr/shared": ["../../packages/shared/src/index.ts"],
      "@dr/shared/*": ["../../packages/shared/src/*"],
      "@dr/db": ["../../packages/db/src/index.ts"],
      "@dr/db/*": ["../../packages/db/src/*"]
    },
    "exactOptionalPropertyTypes": false
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "coverage", "playwright-report"]
}
