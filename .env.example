# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser — treat as public.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Domain Reseller"

# ── Supabase ────────────────────────────────────────────────────────────────
# Local values come from `pnpm db:start`.
# Remote: https://<ref>.supabase.co  ·  Local (pnpm db:start): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET KEY — server only. Never in apps/web client code. Gateway + Edge Functions only.
# New-format key (sb_secret_…). Legacy service_role JWTs are deprecated by end of 2026.
SUPABASE_SECRET_KEY=

# ── Registrar gateway (the ONLY service that talks to DomainNameAPI) ────────
GATEWAY_URL=http://localhost:8787
GATEWAY_SHARED_SECRET=
# Pre-launch: only these accounts (comma-separated emails) may pay. Leave empty to open checkout.
CHECKOUT_ALLOWLIST=

# ── DomainNameAPI — gateway process ONLY, never in apps/web ─────────────────
# UUID Reseller ID + API Key → REST transport. See docs/PRD.md §5.2.
DNA_RESELLER_ID=
DNA_API_KEY=
# Where READS go (availability, balance):
# 'ote' → https://ote.domainresellerapi.com/api/v1 | 'production' → api.domainresellerapi.com
DNA_ENV=ote
# The sandbox (OTE) key — the sandbox refuses the production key.
DNA_API_TEST_KEY=
# Where REGISTRATIONS go, and so which paid orders get registered:
# 'off' (default) runs no provisioning · 'ote' registers test-payment orders in
# the sandbox · 'production' registers real orders (refused unless NODE_ENV=production).
DNA_WRITE_ENV=off
# How often the provisioning worker looks for due jobs, in ms.
PROVISION_POLL_MS=5000
# How often the portfolio is compared with the registry (runs only when DNA_WRITE_ENV is on).
RECONCILE_EVERY_MINUTES=60
# Supplier SDK telemetry MUST stay disabled — NDPA. See PRD §5.5 / SEC-14.
DNA_TELEMETRY=false

# ── Flutterwave (test keys only outside production — N12) ─────────────────
# Dashboard → Settings → API keys. The webhook hash is the "secret hash" you
# set under Settings → Webhooks; Flutterwave sends it back as `verif-hash`.
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ── Pricing / FX ────────────────────────────────────────────────────────────
FX_BUFFER_PCT=4
FX_SOURCE_API_KEY=
PRICE_LOCK_MINUTES=30

# ── Notifications ───────────────────────────────────────────────────────────
# Which service sends email, in the web (auth emails) and the gateway (the
# outbox): `brevo` (the default) or `ses`. The privacy notice names it, so the
# web reads it at build time. See docs/DEPLOY.md §5c.
EMAIL_PROVIDER=brevo
# Brevo: the API key sends email; the SMTP login and key are Supabase Auth's
# fallback (supabase/config.toml). The hook secret is `v1,whsec_<base64>`.
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
SEND_EMAIL_HOOK_SECRET=
# Amazon SES (API v2) — a sending-only IAM user's key, in eu-west-2, with the
# configuration set whose event destination publishes to the SNS topic below.
AWS_SES_REGION=eu-west-2
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_CONFIGURATION_SET=mydomainshub
# The account's maximum send rate, messages a second (1 in the SES sandbox).
SES_MAX_SEND_RATE=1
# Web only: /api/email/ses-events acts on SNS messages for this topic alone.
SES_EVENTS_TOPIC_ARN=
# SES's SMTP credentials, for Supabase Auth's fallback once SES is the provider.
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=

# ── Bot protection: Cloudflare Turnstile (SEC-9) ───────────────────────────
# Dashboard → Turnstile → add the site (widget mode: Managed). Both or neither:
# until both are set, sign-up, email links and search run without the check.
# Playwright uses Cloudflare's always-pass test keys (apps/web/playwright.config.ts).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Observability (our own Sentry, not the supplier SDK's) ──────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info
